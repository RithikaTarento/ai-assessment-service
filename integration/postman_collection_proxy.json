{
  "info": {
    "_postman_id": "b3f2a1d4-8c9e-4f2a-b1c3-7d0e5f4a9b2c",
    "name": "iGOT AI Assessments (UI Proxy)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "AI Assessment Generation Service — accessed via UI Proxy (cookie-based auth, no API keys)\n\n**Environments:**\n- UAT via UI Proxy: set `base_url` = `https://portal.uat.karmayogibharat.net/apis/proxies/v8/ai/assessments/v1`\n\n**Variables to set:**\n- `base_url`   — full base URL including version prefix (see above)\n- `cookie`     — session cookie from browser (connect.sid=...)\n- `job_id`     — paste Job ID returned from Generate to use in Status / Update / Download"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://portal.uat.karmayogibharat.net/apis/proxies/v8/ai/assessments/v1",
      "description": "Full base URL including version. UAT: https://portal.uat.karmayogibharat.net/apis/proxies/v8/ai/assessments/v1"
    },
    {
      "key": "cookie",
      "value": "",
      "description": "Session cookie from browser — e.g. connect.sid=s%3A..."
    },
    {
      "key": "job_id",
      "value": "",
      "description": "Job ID returned from the Generate request — paste it here to use in Status / Update / Download"
    },
    {
      "key": "question_id",
      "value": "mcq_001"
    }
  ],
  "item": [
    {
      "name": "Generate Assessment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "accept",
            "value": "application/json"
          },
          {
            "key": "cookie",
            "value": "{{cookie}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "type": "text",
              "key": "course_ids",
              "value": "do_1144540583527301121908",
              "description": "Comma-separated course IDs"
            },
            {
              "type": "text",
              "key": "assessment_type",
              "value": "practice",
              "description": "practice | final | comprehensive | standalone | competency"
            },
            {
              "type": "text",
              "key": "difficulty",
              "value": "intermediate",
              "description": "beginner | intermediate | advanced"
            },
            {
              "type": "text",
              "key": "language",
              "value": "english"
            },
            {
              "type": "text",
              "key": "total_questions",
              "value": "10"
            },
            {
              "type": "text",
              "key": "question_type_counts",
              "value": "{\"mcq\":5,\"ftb\":5,\"mtf\":0,\"multichoice\":0,\"truefalse\":0}"
            },
            {
              "type": "text",
              "key": "enable_blooms",
              "value": "true"
            },
            {
              "type": "text",
              "key": "blooms_config",
              "value": "{\"Remember\":20,\"Understand\":30,\"Apply\":30,\"Analyze\":10,\"Evaluate\":10,\"Create\":0}"
            },
            {
              "type": "text",
              "key": "force",
              "value": "false",
              "description": "true = bypass cache and regenerate"
            },
            {
              "type": "text",
              "key": "time_limit",
              "value": "0",
              "description": "Minutes — 0 means no limit"
            },
            {
              "type": "text",
              "key": "topic_names",
              "value": "",
              "description": "Optional comma-separated topics"
            },
            {
              "type": "text",
              "key": "course_weightage",
              "value": "",
              "description": "Comprehensive only — JSON e.g. {\"do_1\":60,\"do_2\":40}"
            },
            {
              "type": "text",
              "key": "course_names",
              "value": "",
              "description": "Optional — comma-separated course names matching the order of course_ids e.g. \"Course A,Course B\""
            },
            {
              "type": "text",
              "key": "competency_area",
              "value": "",
              "description": "Required for competency type — e.g. Behavioural"
            },
            {
              "type": "text",
              "key": "competency_themes",
              "value": "",
              "description": "Required for competency type — pass as repeated fields e.g. Service Orientation"
            },
            {
              "type": "text",
              "key": "competency_sub_themes",
              "value": "",
              "description": "Required for competency type — pass as repeated fields e.g. Citizen Centricity"
            },
            {
              "type": "text",
              "key": "additional_instructions",
              "value": ""
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/generate",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "generate"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "accept",
            "value": "application/json"
          },
          {
            "key": "cookie",
            "value": "{{cookie}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/status/{{job_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "status",
            "{{job_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Edit Question",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "accept",
            "value": "application/json"
          },
          {
            "key": "cookie",
            "value": "{{cookie}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request\": {\n    \"questionId\": \"{{question_id}}\",\n    \"version\": 1,\n    \"updates\": {\n      \"question_text\": \"Revised question text?\",\n      \"correct_option_index\": 2,\n      \"blooms_level\": \"Apply\",\n      \"relevance_percentage\": 88,\n      \"answer_rationale.correct_answer_explanation\": \"Option C is correct because ...\",\n      \"reasoning.learning_objective_alignment\": \"LO-3: Evaluate policy instruments\",\n      \"course_name\": \"Foundations of Public Policy\",\n      \"reasoning.competency_alignment.kcm.competency_area\": \"Behavioural\",\n      \"reasoning.competency_alignment.kcm.competency_theme\": \"Outcome Orientation\",\n      \"reasoning.competency_alignment.kcm.competency_sub_theme\": \"Accountability\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/questions/update/{{job_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "questions",
            "update",
            "{{job_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Add Question",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "accept",
            "value": "application/json"
          },
          {
            "key": "cookie",
            "value": "{{cookie}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request\": {\n    \"questionType\": \"mcq\",\n    \"position\": 1,\n    \"version\": 1,\n    \"question\": {\n      \"question_text\": \"Which body approves the Union Budget?\",\n      \"options\": [\n        {\n          \"text\": \"Parliament\",\n          \"index\": 0\n        },\n        {\n          \"text\": \"NITI Aayog\",\n          \"index\": 1\n        },\n        {\n          \"text\": \"RBI\",\n          \"index\": 2\n        },\n        {\n          \"text\": \"Cabinet Secretariat\",\n          \"index\": 3\n        }\n      ],\n      \"correct_option_index\": 0,\n      \"blooms_level\": \"Remember\",\n      \"relevance_percentage\": 85,\n      \"difficulty_level\": \"intermediate\",\n      \"course_name\": \"Foundations of Public Policy\",\n      \"answer_rationale\": {\n        \"correct_answer_explanation\": \"Parliament approves the Union Budget.\",\n        \"why_factor\": \"Constitutional mandate\",\n        \"logic_justification\": \"Article 112\"\n      },\n      \"reasoning\": {\n        \"learning_objective_alignment\": \"LO-1: Identify budget authorities\",\n        \"competency_alignment\": {\n          \"kcm\": {\n            \"competency_area\": \"Functional\",\n            \"competency_theme\": \"Public Finance\",\n            \"competency_sub_theme\": \"Budgeting\"\n          }\n        }\n      }\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/questions/create/{{job_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "questions",
